---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile } from '../lib/profile';
import { splitName } from '../components/profile-view';

const { primary } = splitName(loadProfile().name);
---
<BaseLayout
  title={`ติดต่อ · ${primary}`}
  description={`ส่งข้อความถึง ${primary} ผ่านฟอร์มติดต่อ อีเมลของคุณใช้ตอบกลับเท่านั้น ไม่แสดงบนเว็บ`}
>
  <section class="card" aria-labelledby="contact-title">
    <h1 id="contact-title">ติดต่อฉัน</h1>
    <p>อยากคุยกัน ถามอะไร หรือแนะนำเรื่องที่น่าลองก็ส่งมาทางฟอร์มนี้ได้เลยค่ะ</p>
    <form id="contact-form" novalidate>
      <label for="contact-name">ชื่อของคุณ</label>
      <input id="contact-name" name="name" required maxlength="80" autocomplete="name" />

      <label for="contact-email">อีเมล</label>
      <input id="contact-email" name="email" type="email" required maxlength="120" autocomplete="email" aria-describedby="contact-email-hint" />

      <label for="contact-message">ข้อความ</label>
      <textarea id="contact-message" name="message" rows="6" required maxlength="2000"></textarea>

      <div class="hp" aria-hidden="true">
        <label for="contact-website">เว็บไซต์ (เว้นว่างไว้)</label>
        <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <p class="form-actions"><button type="submit">ส่งข้อความ</button></p>
      <p id="contact-email-hint" class="hint">อีเมลใช้ตอบกลับเท่านั้น ไม่แสดงบนเว็บค่ะ</p>
      <p id="contact-status" class="status" role="status" aria-live="polite"></p>
    </form>
  </section>
</BaseLayout>
<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-status');

  // Friendly fixed messages only — never show the server's error text.
  const MSG = {
    busy: 'กำลังส่งข้อความค่ะ…',
    ok: 'ได้รับแล้วค่ะ ฉันจะแวะอ่านเป็นระยะ ๆ นะคะ',
    invalid: 'รบกวนกรอกชื่อ อีเมลที่ถูกต้อง และข้อความให้ครบก่อนนะคะ',
    rejected: 'ส่งไม่สำเร็จค่ะ ลองเช็คข้อมูลอีกนิด แล้วส่งใหม่อีกครั้งนะคะ',
    unavailable: 'ตอนนี้ฟอร์มยังรับข้อความไม่ได้ค่ะ ขอโทษด้วยนะคะ ลองใหม่อีกครั้งภายหลังนะคะ',
    network: 'ส่งไม่สำเร็จค่ะ ลองเช็คอินเทอร์เน็ตแล้วส่งใหม่อีกครั้งนะคะ',
  };

  function setStatus(text: string, state: 'busy' | 'ok' | 'error') {
    if (!status) return;
    status.textContent = text;
    status.dataset.state = state;
  }

  // Clear a field's aria-invalid as soon as the visitor fixes it, not only on the next submit.
  form?.addEventListener('input', (e) => {
    const f = e.target as HTMLInputElement;
    if (f.validity?.valid) f.removeAttribute('aria-invalid');
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    // Mark bad fields for screen readers; empty aria-invalid means false, so set "true" explicitly.
    // Honeypot fields live inside .hp and are skipped whatever their name.
    form.querySelectorAll<HTMLInputElement>('input, textarea').forEach((f) => {
      if (f.closest('.hp')) return;
      if (f.validity.valid) f.removeAttribute('aria-invalid');
      else f.setAttribute('aria-invalid', 'true');
    });
    if (!form.checkValidity()) {
      setStatus(MSG.invalid, 'error');
      form.reportValidity();
      return;
    }
    const fd = new FormData(form);
    const payload = {
      name: String(fd.get('name') ?? '').trim(),
      email: String(fd.get('email') ?? '').trim(),
      message: String(fd.get('message') ?? '').trim(),
      website: String(fd.get('website') ?? ''),
    };
    const button = form.querySelector('button');
    if (button) button.disabled = true;
    setStatus(MSG.busy, 'busy');
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        setStatus(MSG.ok, 'ok');
        form.reset();
      } else if (res.status >= 500) {
        setStatus(MSG.unavailable, 'error');
      } else {
        setStatus(MSG.rejected, 'error');
      }
    } catch {
      setStatus(MSG.network, 'error');
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
