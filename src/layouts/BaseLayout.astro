---
import { loadProfile } from '../lib/profile';
import { splitName } from '../components/profile-view';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;

const profile = loadProfile();
const { primary, alternate } = splitName(profile.name);

// JSON-LD Person: only the public fields approved in D8. No email, jobTitle,
// worksFor, address, image, and nothing from the guestbook.
const person: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: primary,
  ...(alternate ? { alternateName: alternate } : {}),
  ...(profile.headline ? { description: profile.headline } : {}),
  url: Astro.site ? new URL('/', Astro.site).href : undefined,
  ...(profile.interests.length ? { knowsAbout: profile.interests } : {}),
};
const jsonLd = JSON.stringify(person).replace(/</g, '\\u003c');

const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'หน้าแรก', active: path === '/' },
  { href: '/about', label: 'เกี่ยวกับฉัน', active: path.startsWith('/about') },
  { href: '/interests', label: 'สิ่งที่สนใจ', active: path.startsWith('/interests') },
  { href: '/contact', label: 'ติดต่อ', active: path.startsWith('/contact') },
  { href: '/guestbook', label: 'สมุดเยี่ยม', active: path.startsWith('/guestbook') },
];
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#main">ข้ามไปที่เนื้อหา</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">{primary}</a>
        <nav aria-label="เมนูหลัก">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>© {new Date().getFullYear()} {primary}</p>
      </div>
    </footer>
  </body>
</html>
